{
  "manifest_version": 3,
  "name": "Chrome Bridge",
  "version": "3.1.0",
  "description": "MCP bridge to your everyday Chrome: lets paired AI agents drive your real profile via chrome.debugger, with a permission gate, site blocklist and activity log.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "browsingData",
    "cookies",
    "debugger",
    "declarativeNetRequest",
    "downloads",
    "history",
    "notifications",
    "scripting",
    "sessions",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
